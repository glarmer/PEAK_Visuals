<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>com.github.glarmer.PEAK_Visuals</AssemblyName>
        <AssemblyTitle>PEAK_Visuals</AssemblyTitle>
        <Version>2.0.0</Version>
    </PropertyGroup>

    <PropertyGroup>
        <NvidiaDLSSNativeDir Condition="'$(NvidiaDLSSNativeDir)' == '' and Exists('$(HOME)/Unity/Hub/Editor/6000.3.15f1/Editor/Data/PlaybackEngines/WindowsStandaloneSupport/Variations/win64_player_nondevelopment_mono/NVUnityPlugin.dll')">$(HOME)/Unity/Hub/Editor/6000.3.15f1/Editor/Data/PlaybackEngines/WindowsStandaloneSupport/Variations/win64_player_nondevelopment_mono/</NvidiaDLSSNativeDir>
    </PropertyGroup>

    <ItemGroup Condition="'$(NvidiaDLSSNativeDir)' != ''">
        <None Include="$(NvidiaDLSSNativeDir)NVUnityPlugin.dll" Link="NVUnityPlugin.dll" CopyToOutputDirectory="PreserveNewest" />
        <None Include="$(NvidiaDLSSNativeDir)nvngx_dlss.dll" Link="nvngx_dlss.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="WarnMissingNvidiaDLSSNative" BeforeTargets="Build" Condition="'$(NvidiaDLSSNativeDir)' == ''">
        <Warning Text="DLSS native DLLs were not found. Set NvidiaDLSSNativeDir to a Unity WindowsStandaloneSupport win64_player_nondevelopment_mono directory containing NVUnityPlugin.dll and nvngx_dlss.dll." />
    </Target>

</Project>
